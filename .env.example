# Required server-only Resend key. Never prefix this with NEXT_PUBLIC_.
RESEND_API_KEY=

# Verify stackorcs.com in Resend and keep its SPF/DKIM DNS records in place.
# Public delivery requires a verified domain; resend.dev is test-only.
RESEND_FROM_EMAIL=StackOrcs <updates@stackorcs.com>
RESEND_REPLY_TO=vivekni1224@gmail.com
RESEND_NEWSLETTER_SEGMENT_ID=
CONTACT_RECIPIENT=vivekni1224@gmail.com

# Protects /admin and /api/admin/publish. Generate a long random value.
ADMIN_PUBLISH_KEY=
